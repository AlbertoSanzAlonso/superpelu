# Copia a openwa-prod.env y ajusta (openwa-prod.env no va a git).
# Uso: ./scripts/openwa-prod.sh <comando>

# SSH al servidor donde corre OpenWA (Coolify / Oracle)
SSH_USER=root
SSH_HOST=157.180.36.231
# Opcional: clave o ruta (-i ~/.ssh/id_ed25519 se pasa con SSH_OPTS)
# SSH_OPTS=-i ~/.ssh/mi_clave

OPENWA_API_KEY=tu-api-key
OPENWA_PORT=2785
OPENWA_SESSION_NAME=superpelu
# host | docker | auto (auto prueba host y luego docker)
OPENWA_EXEC=docker
# OPENWA_DOCKER_CONTAINER=nombre-exacto-del-contenedor
# OPENWA_SESSION_ID=sess_xxxxxxxx

# Superpelu (opcional, para comprobar desde fuera)
SUPERPELU_URL=https://superpelubenalmadena.es
# ADMIN_SECRET=...
