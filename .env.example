# Copia a .env y ajusta en local:  cp .env.example .env

# Administración (/agenda → Administración)
ADMIN_SECRET=superpelu-dev-admin

# Profesionales (/agenda → Mi agenda): nombre exacto + contraseña
#   Todas  →  Superpelu2026  (Susana, Mónica, Andrea, Olga, Inma)
# (origen: src/data/salonStaff.ts, sincronizado al arrancar el servidor)

PORT=3001

# Supabase — opción A: URI completa (Connect → Session, puerto 5432; recomendado para Coolify/Node)
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:5432/postgres
# Transaction (6543) solo para serverless corto; en Node persistente puede fallar tras el arranque
#
# Opción B (recomendada en Coolify): ref + contraseña en texto plano — sin pegar URI
# SUPABASE_PROJECT_REF=abcdefghijklmnop
# SUPABASE_DB_PASSWORD=tu-contraseña
# SUPABASE_DB_PORT=5432
# SUPABASE_REGION=eu-central-1

# Cliente JS en el frontend (Vite — no uses NEXT_PUBLIC_*)
# VITE_SUPABASE_URL=https://TU_REF.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Migración desde SQLite local (opcional, una vez):
# SQLITE_PATH=./data/appointments.sqlite
# npm run db:migrate-sqlite

# WhatsApp vía OpenWA — ver docs/openwa.md
# Dev: cd openwa && docker compose -f docker-compose.dev.yml up -d
#   Dashboard http://localhost:2886 · API http://localhost:2785/api
# OPENWA_ENABLED=true
# OPENWA_API_URL=http://127.0.0.1:2785/api          # npm run dev en el host
# OPENWA_API_URL=http://openwa:2785/api              # docker compose --profile openwa
# OPENWA_API_KEY=<api-key del dashboard OpenWA>
# OPENWA_SESSION_ID=<id de sesión, p. ej. sess_abc123>
# OPENWA_NOTIFY_PUBLIC_ONLY=false   # true = solo /reservar, no agenda admin/staff

# Producción (Coolify) — OpenWA: docs/deploy-coolify-openwa.md
# ADMIN_SECRET=<clave-segura>
# DATABASE_URL=<connection-string-supabase>
# NODE_ENV=production
# CORS_ORIGIN=https://superpelubenalmadena.es
# OPENWA_ENABLED=true
# OPENWA_API_URL=http://openwa:2785/api
# OPENWA_API_KEY=...
# OPENWA_SESSION_ID=sess_...

# Enlaces del mensaje de WhatsApp (gestionar / cancelar cita / calendario):
# - «Gestionar tu cita» → /m/… (cambiar fecha/hora o cancelar). Requiere URL pública:
# PUBLIC_BASE_URL=https://superpelubenalmadena.es   # o CORS_ORIGIN con la misma URL
# - Clave para firmar los enlaces de cancelación (por defecto usa ADMIN_SECRET):
# CANCEL_TOKEN_SECRET=<clave-larga-opcional>

# Recordatorio de WhatsApp 24h antes de la cita (requiere OpenWA configurado):
# REMINDERS_ENABLED=true            # false para desactivar el recordatorio
# REMINDER_HOURS_BEFORE=24          # horas antes de la cita
# REMINDER_POLL_MINUTES=10          # cada cuánto revisa el servidor las citas pendientes

# Aviso por email al administrador en cada cita nueva o cancelada (SMTP):
# EMAIL_ENABLED=true
# ADMIN_NOTIFICATION_EMAIL=admin@superpelu.es   # RECEPTOR de los avisos; varios con comas
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587                                  # 465 = SSL (secure); 587 = STARTTLS
# SMTP_SECURE=false                              # true para el puerto 465
# SMTP_USER=remitente@gmail.com                  # cuenta que ENVÍA (Gmail: 2FA activada)
# SMTP_PASS=contraseña-de-aplicacion             # Gmail: NO la contraseña normal (apppasswords)
# EMAIL_FROM=Superpelu <remitente@gmail.com>     # remitente mostrado; por defecto usa SMTP_USER
# Botón «Ir a agenda» en el email (obligatorio en producción para que aparezca):
# PUBLIC_BASE_URL=https://superpelubenalmadena.es   # o CORS_ORIGIN con la misma URL
# ADMIN_AGENDA_URL=https://superpelubenalmadena.es/agenda   # opcional; anula base + /agenda
