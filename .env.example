# Copia a .env y ajusta en local:  cp .env.example .env

# Administración (/agenda → Administración)
ADMIN_SECRET=superpelu-dev-admin

# Profesionales (/agenda → Mi agenda): nombre exacto + contraseña
#   Susana  →  Pelu-Susana26
#   Mónica  →  Pelu-Monica26
#   Andrea  →  Pelu-Andrea26
#   Olga    →  Pelu-Olga26
# (origen: src/data/salonStaff.ts, sincronizado al arrancar el servidor)

PORT=3001

# Supabase — opción A: URI completa (Settings → Database → Connect → Transaction)
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
#
# Opción B: ID del proyecto (en la URL del dashboard) + contraseña de la BD
# SUPABASE_PROJECT_REF=abcdefghijklmnop
# SUPABASE_DB_PASSWORD=tu-contraseña
# SUPABASE_REGION=eu-central-1

# Migración desde SQLite local (opcional, una vez):
# SQLITE_PATH=./data/appointments.sqlite
# npm run db:migrate-sqlite

# Producción (Coolify)
# ADMIN_SECRET=<clave-segura>
# DATABASE_URL=<connection-string-supabase>
# NODE_ENV=production
# CORS_ORIGIN=https://superpelubenalmadena.es
