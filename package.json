{
  "name": "superpelu",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c blue,magenta \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "start": "tsx server/index.ts",
    "preview": "vite preview",
    "gallery:webp": "node scripts/convert-gallery-to-webp.mjs",
    "db:migrate-sqlite": "node scripts/migrate-sqlite-to-postgres.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.4",
    "@supabase/supabase-js": "^2.106.2",
    "hono": "^4.12.23",
    "postgres": "^3.4.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.15.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.8",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "better-sqlite3": "^12.10.0",
    "concurrently": "^9.2.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.8",
    "tsx": "^4.22.3",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
