{
  "name": "superpelu",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c blue,magenta \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "vite",
    "dev:api": "tsx watch --tsconfig tsconfig.server.json server/index.ts",
    "build": "tsc -b && vite build",
    "start": "tsx --tsconfig tsconfig.server.json server/index.ts",
    "preview": "vite preview",
    "gallery:webp": "node scripts/convert-gallery-to-webp.mjs",
    "db:check": "node scripts/db-check.mjs",
    "db:migrate-sqlite": "node scripts/migrate-sqlite-to-postgres.mjs",
    "openwa:up": "docker compose -f deploy/openwa-local.compose.yml up -d --build",
    "openwa:down": "docker compose -f deploy/openwa-local.compose.yml down",
    "openwa:logs": "docker compose -f deploy/openwa-local.compose.yml logs -f",
    "openwa:setup": "node scripts/openwa-local.mjs",
    "openwa:prod": "bash scripts/openwa-prod.sh",
    "docker:install": "bash scripts/install-docker.sh"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.4",
    "@supabase/supabase-js": "^2.106.2",
    "hono": "^4.12.23",
    "nodemailer": "^8.0.10",
    "postgres": "^3.4.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.15.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.8",
    "@types/node": "^22.15.21",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^4.4.1",
    "better-sqlite3": "^12.10.0",
    "concurrently": "^9.2.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.8",
    "tsx": "^4.22.3",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
