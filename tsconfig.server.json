{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@server/*": ["server/*"]
    }
  },
  "include": ["server", "src"],
  "exclude": [
    "src/components",
    "src/hooks",
    "src/pages",
    "src/styles",
    "src/assets",
    "src/main.tsx",
    "src/App.tsx",
    "src/vite-env.d.ts",
    "src/i18n/LocaleProvider.tsx",
    "src/i18n/useTranslation.ts",
    "src/lib/agenda/adminBrowserNotifications.ts",
    "src/lib/api",
    "src/lib/booking/calendar.ts",
    "src/lib/supabaseClient.ts",
    "src/data/galleryImages.ts",
    "src/data/marketingServices.ts",
    "src/data/galleryContent.ts"
  ]
}
